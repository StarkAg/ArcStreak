{
  "expo": {
    "name": "Arc Streak - Habit Tracker",
    "slug": "arcstreak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
