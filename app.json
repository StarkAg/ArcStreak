        "backgroundColor": "#000000"
      },
      "package": "com.arcstreak.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "arcstreak",
    "plugins": [
      "expo-router"
    ],
    "updates": {
      "url": "https://u.expo.dev/aa066bb5-8d1d-4a15-a1b3-f57a6b963a7e"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa066bb5-8d1d-4a15-a1b3-f57a6b963a7e"
      }
    },
    "owner": "stark954"
  }
